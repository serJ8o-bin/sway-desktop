{
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin": "0",
    
    "modules-left": ["sway/workspaces", ],
    "modules-center": ["custom/rune", "sway/window", "custom/rune_inv"],
    "modules-right": [ "mpris","cpu", "memory", "clock", "tray"],    

    "sway/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },
    
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "RAM {used}G / {total}G",
        "interval": 2,
        "tooltip": false
    },

    "custom/rune": {
        "format": "ᛉ",
        "tooltip": false
    },

    "custom/rune_inv": {
        "format": "ᛦ",
        "tooltip": false
    },


    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "{status_icon} <i>{artist} - {title}</i>",
        "player-icons": {
            "default": "▶"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "tooltip": false
    },

    "clock": {
        "format": "{:%d.%m %H:%M}",
        "interval": 60
    },
    
    "tray": {
        "spacing": 10,
        "icon-size": 16
    }
}
